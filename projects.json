[
  {
    "id": "dotdotdot",
    "folder": "dotdotdot",
    "titleKo": "점, 점점",
    "titleEn": "DOT, Dot dot",
    "format": "Exhibition Identity",
    "client": "서울여자대학교 공예전공 도자심화",
    "date": "2025. 10",
    "taglineKo": "서울여자대학교 아트앤디자인스쿨 공예전공 도자심화 제58회 졸업작품전",
    "bodyKo": "점이라는 가장 작고 근본적인 조형 단위로부터 출발하여, 구의 표면을 평면 위에 펼치는 구 전개도를 핵심 그래픽 모티브로 삼았다. 방사형으로 뻗어나가는 점들의 궤적은 수학적이면서도 유기적인 긴장감을 만들어내며, 점이 선이 되고 선이 형태가 되는 확장의 과정 자체를 전시의 언어로 삼는다.",
    "taglineEn": "",
    "bodyEn": "Beginning from the dot — the most elemental unit of form — the project adopts the sphere development diagram as its central graphic motif, mapping the surface of a three-dimensional sphere onto a flat plane. The radial trajectories of accumulated dots carry both mathematical precision and organic resonance, making the act of expansion itself the visual language of the exhibition.",
    "type": "Commercial",
    "categories": [
      "Graphic",
      "Identity"
    ],
